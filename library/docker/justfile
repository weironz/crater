# library/docker —— 构建 / 推送 / 导出 docker 的 OCI 制品(B 类 artifact)。
# 需要 just:https://github.com/casey/just (apt install just / cargo install just / 下载二进制)
#
# 用法:
#   just                                   # 列出命令
#   just build                             # 构建到本地库 ~/.crater/store
#   just push                              # 构建并推送到 registry
#   just save                              # 构建并导出离线 .oci(拷给 air-gap 机器)
#   just registry=192.168.1.5:5000 namespace=lib push   # 覆盖私有库 / 离线库
#   just version=27.4.0 push                # 出别的版本(tag 与内容一并改)
#
# 版本写这里即可:`--set version=...` 保证 tag 与实际拉取的版本始终一致(D-089);
# docker.yaml 的 vars.version 只是直接 `crater apply -f` 时的缺省。

registry  := "docker.io"        # registry 主机:docker.io / 192.168.1.5:5000(私有/离线)
namespace := "willdockerhub"    # 命名空间 / 组织
name      := "docker"
version   := "27.3.1"
ref       := registry + "/" + namespace + "/" + name + ":" + version

# 列出可用命令(默认)
default:
    @just --list

# 构建 OCI 制品到本地库(--set 让 tag 与实际拉取的版本始终一致)
build:
    crater build -f {{name}}.yaml -t {{ref}} --set version={{version}}

# 构建并推送到 registry
push: build
    crater push {{ref}}

# 构建并导出为离线 .oci 文件
save: build
    crater save {{ref}} -o {{name}}-{{version}}.oci

# 删除本地导出的 .oci
clean:
    rm -f *.oci
