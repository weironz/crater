# 每台控制面上的内网 L4 入口。共享 DNS 名在所有节点解析到这三台入口；
# 后端列表来自 inventory 的控制面成员。
stream {
  upstream kube_apiserver {
    least_conn;
{% for node in fleet.controlplane %}
    server {{ node.address }}:{{ params.apiserver_port }} max_fails=1 fail_timeout=5s;
{% endfor %}
  }

  server {
    listen {{ substrate.ip }}:8443;
    proxy_connect_timeout 5s;
    proxy_timeout 1h;
    proxy_pass kube_apiserver;
  }
}
