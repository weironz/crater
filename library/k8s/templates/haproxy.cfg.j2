global
  log /dev/log local0
  maxconn 4000
defaults
  log global
  mode tcp
  option tcplog
  timeout connect 5s
  timeout client 30s
  timeout server 30s
frontend kube-apiserver
  bind *:8443
  default_backend kube-apiserver
backend kube-apiserver
  balance roundrobin
{% for node in groups.controlplane %}
  server {{ node.name }} {{ node.ip }}:{{ apiserver_port }} check
{% endfor %}
