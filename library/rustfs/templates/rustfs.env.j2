# RustFS 环境 —— 由机群视角渲染。
#
# 分布式模式下,**每台**都必须列出**全体**节点的卷 URL 且顺序一致:
# 纠删码靠这份完全一致的清单算分片归属。手工维护它是旧 task 版最易错的
# 地方(加一台要改所有机器);这里它是 fleet.storage 的一次循环。
RUSTFS_ACCESS_KEY={{ params.access_key }}
RUSTFS_SECRET_KEY={{ params.secret_key }}
{% if fleet.storage | length > 1 %}
RUSTFS_VOLUMES="{% for n in fleet.storage %}http://{{ n.address }}:{{ params.port }}{{ params.data_dir }} {% endfor %}"
{% else %}
RUSTFS_VOLUMES="{{ params.data_dir }}"
{% endif %}
RUSTFS_ADDRESS=":{{ params.port }}"
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_CONSOLE_ADDRESS=":{{ params.console_port }}"
RUSTFS_UNSAFE_BYPASS_DISK_CHECK={{ params.bypass_disk_check }}
RUST_LOG=error
RUSTFS_OBS_LOG_DIRECTORY="/var/logs/rustfs/"
