[Unit]
Description=MinIO distributed object storage
After=network-online.target
Wants=network-online.target

[Service]
# Type=simple 而不是 notify —— 这不是省事,是建模上的必然。
#
# 分布式 MinIO 要**达成法定人数**才发就绪通知,而部署是逐台进行的:
# 第一台启动时其余三台还不存在,notify 永远等不到,systemd 90 秒后判定
# 启动失败 —— 而进程其实好好地在跑、在等同伴。
#
# 正确的分工是:systemd 只负责"进程拉起来了",**集群是否可服务由 health
# 探针回答**(蓝图里的 http /minio/health/live)。把两者混为一谈,就会得到
# "服务启动失败但服务在跑"这种自相矛盾的状态。
Type=simple
User=appsvc
Group=appsvc
EnvironmentFile=/etc/default/minio
ExecStart=/usr/local/bin/minio server $MINIO_OPTS $MINIO_VOLUMES
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
