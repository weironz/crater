# MinIO 环境 —— 由机群视角渲染。
#
# MINIO_VOLUMES 必须在**每台**上都列出**全体**节点:分布式 MinIO 靠这份完全
# 一致的清单来算纠删码的分片归属。任何一台列漏,集群就起不来。
# 手工维护这份清单是最容易出错的地方 —— 加一台机器要改所有机器。
MINIO_ROOT_USER={{ params.root_user }}
MINIO_ROOT_PASSWORD={{ params.root_pass }}
MINIO_OPTS="--address :{{ params.api_port }} --console-address :{{ params.con_port }}"
MINIO_VOLUMES="{% for n in fleet.storage %}http://{{ n.address }}:{{ params.api_port }}{{ params.data_dir }} {% endfor %}"
